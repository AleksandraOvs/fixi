(function( root, $, undefined ) {
"use strict";

$(function() {

    $(".hamburger").click(function(e) {

        if ($('.panel-adaptive').not('.init')) {
            var list = $('.header__nav__in').html();
            $('.panel-adaptive__nav').html(list);
            $(this).addClass('init');
        }

        if ($(this).hasClass("is-active")) {
            $(".panel-adaptive").removeClass("panel-right");
            $(this).removeClass("is-active");
            $('body').css({'overflow-y' : 'scroll'});
            $('header').removeClass('animate');
        } else {
            $(".panel-adaptive").addClass("panel-right");
            $(this).addClass("is-active");
            $('body').css({'overflow-y' : 'hidden'});
            $('header').addClass('animate');
        }
    });

    if ($(window).width() <= '991') {

        $('.slider-nav').each(function() {
            let html = $(this).clone();
            console.log();
            $(this).closest('.container').append(html);

            $(this).remove();
        });
    };

    var testSwiper = new Swiper(".testimonials-slider", {
        slidesPerView: 1.5,
        spaceBetween: 40,
        loop: true,
        centeredSlides: false,
        centeredSlidesBounds: false,
        pagination: {
            el: ".testimonials-slider .swiper-pa§gination",
            clickable: true
        },
        breakpoints: {  
            991: {
                slidesPerView: 4,
                loop: true,
                centeredSlides: true,
                centeredSlidesBounds: true,
            }
        }
    });

    var newsSwiper = new Swiper(".news-slider", {
        slidesPerView: 1.5,
        spaceBetween: 10,
        loop: true,
        centeredSlides: false,
        centeredSlidesBounds: false,
        pagination: {
            el: ".news-slider__in .swiper-pagination",
            clickable: true
        },
        breakpoints: {  
            991: {
                slidesPerView: 3,
                spaceBetween: 40,
                loop: true,
                centeredSlides: true,
                centeredSlidesBounds: true,
            }
        }
    });

    var docsSwiper = new Swiper(".docs-slider", {
        slidesPerView: 1.5,
        spaceBetween: 20,
        navigation: {
            nextEl: ".doc-slider-nav .swiper-next",
            prevEl: ".doc-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 4
            }
        }
    });

    var videoSwiper = new Swiper(".video-slider", {
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
            nextEl: ".video-slider-nav .swiper-next",
            prevEl: ".video-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 2
            }
        }
    });

    var solSwiper = new Swiper(".solutions-slider", {
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
            nextEl: ".solutions-slider-nav .swiper-next",
            prevEl: ".solutions-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 3
            }
        }
    });

    var teamSwiper = new Swiper(".team-slider", {
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
            nextEl: ".team-slider-nav .swiper-next",
            prevEl: ".team-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 3
            }
        }
    });

    var folioSwiper = new Swiper(".portfolio-slider", {
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
            nextEl: ".portfolio-slider-nav .swiper-next",
            prevEl: ".portfolio-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 3
            }
        }
    });

    var starsSwiper = new Swiper(".stars-slider", {
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
            nextEl: ".stars-slider-nav .swiper-next",
            prevEl: ".stars-slider-nav .swiper-prev"
        },
        breakpoints: {  
            991: {
                slidesPerView: 3
            }
        }
    });

    $(".faq-item.active").each(function() {
        var panel = $(this).find('.faq-answer');
        panel.css('max-height', panel.prop('scrollHeight'));
    });

    $('.faq-question').click(function() {
        
        var cont = $(this).closest(".faq-item");
        var classActive = cont.hasClass("active");

        if (!classActive) {
            cont.addClass("active");
            var panel = cont.find('.faq-answer');
            panel.css('max-height', panel.prop('scrollHeight'));
        } else {
            cont.removeClass("active");
            cont.find('.faq-answer').css('max-height', 0);
        }
    });

    $(".accordion-item.active").each(function() {
        var panel = $(this).find('.accordion-content');
        panel.css('max-height', panel.prop('scrollHeight'));
    });

    $('.accordion-title').click(function() {
        
        var cont = $(this).closest(".accordion-item");
        var classActive = cont.hasClass("active");

        if (!classActive) {
            cont.addClass("active");
            var panel = cont.find('.accordion-content');
            panel.css('max-height', panel.prop('scrollHeight'));
        } else {
            cont.removeClass("active");
            cont.find('.accordion-content').css('max-height', 0);
        }
    });

    /* маска телефона */ 
    var inpTel = document.querySelectorAll('input[name=tel]');
    var mask;
    for(var i = 0; i < inpTel.length; i++) {
      inpTel[i].addEventListener('focus', function(){
        mask = IMask(this, {
            mask: '+{7} 000 000-00-00',
            overwrite: true,
            lazy: false,
            autofix: true,
        });
      })
      inpTel[i].addEventListener('blur', function(){
        if(this.value.match('_')){
          mask.masked.reset()
        }
      })
    };

    /* табы */
    $('.js-tab-nav li a').click(function(e) {
        e.preventDefault();

        var tab  = $(this).data('tab');
        var cont = $(this).closest('.tab-block');

        cont.find('.tab__nav li a').removeClass('active');
        $(this).addClass('active');

        cont.find('.tab-content .tab').removeClass('active');
        cont.find('.tab-content ' + tab).addClass('active');
    });

    var top_show = 150;
    var delay = 1000; 
    $(document).ready(function() {
        $(window).scroll(function () { 
          
          if ($(this).scrollTop() > top_show) $(".top-btn").fadeIn();
          else $(".top-btn").fadeOut();
        });
        $(".top-btn").click(function () {
          $("body, html").animate({
            scrollTop: 0
          }, delay);
        });
    });

    $(".contact-info__item-title").click(function() {
        $(this).closest('.contact-info__item').toggleClass('active');
    });

    $('.js-tab-nav li a').click(function(e) {
        e.preventDefault();

        var tab  = $(this).data('tab');
        var cont = $(this).closest('.tab-block');

        cont.find('.tab__nav li a').removeClass('active');
        $(this).addClass('active');

        cont.find('.tab-content .tab').removeClass('active');
        cont.find('.tab-content ' + tab).addClass('active');
    });

    $('*[data-toggle="modal"]').click(function(e) {
        e.preventDefault();

        var target = $(this).data('target');
        $(target).css('display', 'flex');

    });

    window.onclick = function(event) {
        if (event.target.className == 'modal') {
            $('.modal').hide();
        }
    }

    $('.modal .close').click(function(e) {
        e.preventDefault();

        $(this).closest('.modal').hide();
    });

    $('.title-tabs a').click(function(e) {
        e.preventDefault();

        var tab = $(this).data('tab');
        var cont = $(this).closest('.tabs-block');

        cont.find('.title-tabs a').removeClass('active');
        $(this).addClass('active');

        cont.find('.tab').removeClass('active');
        cont.find('.tab-' + tab).addClass('active');
    });

    /*
    $('body').on('click', '.panel-adaptive__nav .menu-item-has-children', function(e) {
        e.preventDefault();
        $(this).addClass('active');
    });
    */

});

} ( this, jQuery ));